    "trans": {
     "actions": [
      {
       "type": "task",
       "text": "count := 0",
       "id": "n3"
      }
     ],
     "term": {
      "type": "nextstate",
      "text": "READY",
      "id": "n4"
     }
    },
    "id": "n2"
   },
